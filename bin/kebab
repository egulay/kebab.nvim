#!/usr/bin/env bash
#
# kebab -- open and create projects in the kebab.nvim IDE layer.
#
# Deliberately thin: it turns arguments into one call into lua/kebab/cli.lua, so
# the behaviour lives in Lua that the test suite exercises directly.
#
#   kebab                      open the IDE in the current directory
#   kebab <path>               open that directory (or that file's project)
#   kebab open                 pick a project from the known roots
#   kebab open <name>          open the project called <name>
#   kebab new                  create a project, asking as it goes
#   kebab new <name>           same, with the name filled in
#   kebab new <name> --type <t> [--dir <d>] [--<answer> <value>]...
#                              create without being asked anything; any prompt
#                              the type declares is settable as --name value,
#                              e.g. --group com.foo --deps web,data-jpa
#                                   --module github.com/you/thing
#                                   --language javascript  --kind lib
#   kebab new <name> --type <t> --no-open
#                              create it and stop, without opening the editor
#   kebab types [--prompts]    list the project types, and what each one asks
#
#   kebab db                   open the SQL IDE: the explorer, connections on
#                              the left
#   kebab db <connection>      open a SQL console on that saved connection
#   kebab db [...] --env <f>   export a .env file first, so a connection whose
#                              password_env it sets can connect. $KEBAB_DB_ENV
#                              is used when --env is not given, which is what
#                              makes `kebab db` alone enough.
#   Semantic queries, for a caller that is not a person (an AI agent, a script).
#   Read-only: none of these write to the working tree. Add --json for a
#   machine-readable answer, and --exit-code to make `diagnostics` fail when it
#   finds an error (0 clean, 1 error found, 2 inconclusive -- nothing published
#   within the settle window, so a gate must not read it as clean).
#
#   kebab diagnostics <file>            errors and warnings, from the language server
#   kebab definition <file>:<line>:<col>    where that symbol is defined
#   kebab references <file>:<line>:<col>    everywhere it is used
#   kebab symbols <file>                the outline of a file
#   kebab hover <file>:<line>:<col>     its type and documentation
#
#   kebab serve [--socket <path>]       a warm instance, so the language server
#                                       stays attached (~4ms a query instead of
#                                       ~200ms, and jdtls indexes only once)
#   kebab --server <path> <query>...    ask that instance
#
#   kebab <Tab>                shell completion: commands, project types,
#                              saved connections, the prompts a type asks.
#                              `./setup.sh` links it for bash and zsh.
#
#   kebab list                 list the projects found under the known roots
#   kebab types                list the project types that can be created
#   kebab doctor               check the environment
#   kebab help | version
#
# Set KEBAB_DRY_RUN=1 to print the Lua a command would run instead of running it.
#
# Project roots default to ~/Projects, ~/src, ~/code and ~/dev; override with
# KEBAB_PROJECT_ROOTS as a colon-separated
# list. Set KEBAB_NVIM to use a particular Neovim binary.
set -euo pipefail

VERSION="0.1.0"
NVIM="${KEBAB_NVIM:-nvim}"

die() { printf 'kebab: %s\n' "$1" >&2; exit 1; }

# Tab completion is answered before anything else, and *before* the check for
# an editor below: completing `kebab` on a machine where Neovim is missing
# should still work, and the fast path must not pay for a single thing it does
# not need. `KEBAB_NVIM=/nonexistent kebab __complete 1 kebab` is the test.
if [ "${1-}" = "__complete" ]; then
  # Tab completion, answered without starting an editor.
  #
  #   kebab __complete <cword> <word>...
  #
  # One candidate per line. Three sentinels ask the shell to do what only it
  # can: __files, __dirs, __nothing.
  #
  # Nothing here parses Lua or guesses: the authoritative lists come from
  # the cache `kebab.complete` writes on the way out of every command that
  # boots an editor. A missing cache degrades to the command names, which is
  # the common case on a fresh install until the first `kebab doctor`.
  #
  # Why not call `kebab list` or `kebab types` from here: each is an editor
  # start -- 200ms at best -- and a completion that slow is one nobody keeps
  # installed. `KEBAB_NVIM=/nonexistent kebab __complete 1 kebab` is a test
  # that this path never needs one.
  shift
  cword=${1-1}
  shift || true
  words=("$@")
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/nvim/kebab/completion"

  # section -> values, from the cache.
  #
  # Every test here is an `if`, not `[ ... ] && ...`: under `set -e` a false
  # test as the last command of a line exits the script, which is how this
  # block first answered nothing at all -- `[ 1 -lt 1 ]` for a one-word line
  # ended it before a single candidate was printed. Same trap as install.sh.
  cache_values() {
    if [ ! -r "$cache" ]; then
      return 0
    fi
    while IFS=$'\t' read -r section value; do
      if [ "$section" = "$1" ]; then
        printf '%s\n' "$value"
      fi
    done < "$cache"
  }

  commands=$(cache_values command)
  if [ -z "$commands" ]; then
    # No cache yet. These are the commands `bin/kebab` dispatches; the
    # queries come from kebab.agent and are deliberately not duplicated,
    # so an uncached shell completes the subcommands and nothing else.
    commands=$'open\nnew\ntypes\ndb\nlist\ndoctor\nserve\nhelp\nversion'
  fi

  # The word being completed, and the first non-flag word before it.
  current=""
  if [ "$cword" -lt "${#words[@]}" ]; then
    current=${words[$cword]}
  fi
  previous=""
  if [ "$cword" -ge 1 ] && [ "$((cword - 1))" -lt "${#words[@]}" ]; then
    previous=${words[$((cword - 1))]}
  fi
  subcommand=""
  for ((i = 1; i < cword && i < ${#words[@]}; i++)); do
    case "${words[$i]}" in
      --server) ((i++)) ;;
      -*) : ;;
      *) subcommand=${words[$i]}; break ;;
    esac
  done

  # A value for the option just typed, whatever the subcommand.
  case "$previous" in
    --type) printf '%s\n' "$(cache_values type)"; exit 0 ;;
    --dir) printf '__dirs\n'; exit 0 ;;
    --env | --socket | --server) printf '__files\n'; exit 0 ;;
  esac

  if [ -z "$subcommand" ]; then
    printf '%s\n' "$commands"
    exit 0
  fi

  case "$subcommand" in
    open)
      # Project names, which are directory names under the configured roots.
      # Listed rather than validated: checking each for a project marker is
      # the registry's job and would mean reading every candidate, and an
      # over-offered directory costs one clear "no project called x".
      # $KEBAB_PROJECT_ROOTS wins over the cached roots, the same precedence
      # the layer itself uses: a variable set for one invocation is more
      # specific than a config file.
      if [ -n "${KEBAB_PROJECT_ROOTS:-}" ]; then
        roots=${KEBAB_PROJECT_ROOTS//:/$'\n'}
      else
        roots=$(cache_values root)
      fi
      while IFS= read -r root; do
        if [ -n "$root" ] && [ -d "$root" ]; then
          for entry in "$root"/*/; do
            if [ -d "$entry" ]; then
              printf '%s\n' "$(basename "$entry")"
            fi
          done
        fi
      done <<< "$roots"
      ;;
    new)
      if [ -n "$current" ] && [ "${current#--}" != "$current" ]; then
        printf '%s\n' "--type" "--dir" "--no-open"
        while IFS= read -r answer; do
          if [ -n "$answer" ]; then
            printf -- '--%s\n' "$answer"
          fi
        done <<< "$(cache_values answer | sort -u)"
      else
        # the name is the user's to invent
        printf '__nothing\n'
      fi
      ;;
    types)
      printf -- '--prompts\n'
      ;;
    db)
      # Saved connection names, read straight out of the store: no editor,
      # and no `jq` either, since that is optional here.
      local_store=${KEBAB_DB_STORE:-$(cache_values store | head -n 1)}
      : "${local_store:=${XDG_DATA_HOME:-$HOME/.local/share}/nvim/kebab/connections.json}"
      if [ -r "$local_store" ]; then
        # grep -o, not sed: `.*"name"` is greedy, so on a *single line* of
        # JSON -- which is exactly what the store looks like when `jq` is not
        # installed -- only the last connection was ever offered. Found by the
        # spec, which encodes its fixture compactly.
        grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$local_store" \
          | sed 's/.*"\([^"]*\)"$/\1/'
      fi
      printf -- '--env\n'
      ;;
    serve)
      printf -- '--socket\n'
      ;;
    diagnostics | symbols)
      printf '__files\n'
      printf -- '--json\n--exit-code\n'
      ;;
    definition | references | hover)
      # file:line:col -- the path is the part a shell can help with
      printf '__files\n'
      printf -- '--json\n'
      ;;
    *)
      printf '__files\n'
      ;;
  esac
  exit 0
fi

command -v "$NVIM" >/dev/null 2>&1 || die "$NVIM is not on PATH"

# Print the comment block at the top of this file as the help text, so the
# usage and the documentation cannot drift apart.
usage() { sed -n '3,${/^#/!q; s/^# \{0,1\}//p;}' "$0"; }

# Quote a string as a Lua literal. Project names and paths reach Lua through
# this, so a quote or a backslash in a directory name cannot end the string and
# run as code.
lua_str() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# An interactive editor session: Neovim owns the terminal.
#
# With KEBAB_DRY_RUN set, print the Lua that would have run instead. The test
# suite uses this to check argument quoting, which is otherwise unobservable:
# an interactive editor cannot be inspected from a headless test.
run_editor() {
  if [ -n "${KEBAB_DRY_RUN:-}" ]; then
    printf '%s\n' "$1"
    return 0
  fi
  exec "$NVIM" -c "$1"
}

# A report: headless, stdout only, exit code meaningful. Honours KEBAB_DRY_RUN
# for the same reason run_editor does -- so every path can be inspected without
# being executed, including `new --no-open`, which really does create files.
run_headless() {
  if [ -n "${KEBAB_DRY_RUN:-}" ]; then
    printf '%s\n' "$1"
    return 0
  fi
  "$NVIM" --headless -n -c "$1" 2>&1
}

# Quote a string as a JSON string literal. Paths and positions only, so the
# control characters JSON also requires escaping cannot occur here.
json_str() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# Quote a string as a VimScript double-quoted literal, for the --server path.
# A query has to survive shell -> VimScript -> Lua, and the arguments are passed
# as JSON because that is the only encoding all three agree on.
vim_str() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# A unix socket path is limited to about 108 bytes, so the default is kept short
# deliberately -- a path under a long scratch directory silently fails to bind.
default_socket() {
  printf '%s/kebab.sock' "${XDG_RUNTIME_DIR:-/tmp}"
}

# Collect the semantic-query flags, leaving positional arguments in QUERY_ARGS.
parse_query_flags() {
  QUERY_JSON=false
  QUERY_EXIT_CODE=false
  QUERY_TIMEOUT=""
  QUERY_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) QUERY_JSON=true; shift ;;
      --exit-code) QUERY_EXIT_CODE=true; shift ;;
      --timeout)
        [ $# -ge 2 ] || die "--timeout needs a value"
        # This value is interpolated into the Lua chunk below, so it must be a
        # plain integer: anything else either executes as Lua or fails to
        # compile, and a chunk that does not compile never reaches qa!, so
        # headless Neovim hangs with no output.
        case $2 in
          '' | *[!0-9]*) die "--timeout needs a whole number of milliseconds, got: $2" ;;
        esac
        QUERY_TIMEOUT=$2
        shift 2
        ;;
      --) shift; while [ $# -gt 0 ]; do QUERY_ARGS+=("$1"); shift; done ;;
      -*) die "unknown option: $1" ;;
      *) QUERY_ARGS+=("$1"); shift ;;
    esac
  done
}

# The opts table the Lua side expects.
query_opts_lua() {
  local parts="json = $QUERY_JSON, exit_code = $QUERY_EXIT_CODE"
  [ -n "$QUERY_TIMEOUT" ] && parts="$parts, attach_timeout = $QUERY_TIMEOUT"
  printf '{ %s }' "$parts"
}

# A query argument with its path made absolute, keeping any :line:col suffix.
#
# `Foo.java`, `src/Foo.java:10:4` and `/abs/Foo.java` all have to work, and a
# Windows-style drive letter is not a concern here.
absolute_query_arg() {
  local arg=$1
  local path=$arg
  local suffix=""
  # peel off :line:col or :line, if the part before it is not itself a file
  if [[ $arg =~ ^(.*):([0-9]+):([0-9]+)$ ]]; then
    path=${BASH_REMATCH[1]}
    suffix=":${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
  elif [[ $arg =~ ^(.*):([0-9]+)$ ]]; then
    path=${BASH_REMATCH[1]}
    suffix=":${BASH_REMATCH[2]}"
  fi
  case $path in
    /*) printf '%s%s' "$path" "$suffix"; return 0 ;;
  esac
  # Only rewrite something that is actually here; anything else is passed
  # through so the server can report it by the name the caller used.
  if [ -e "$path" ]; then
    printf '%s%s' "$(cd -- "$(dirname -- "$path")" 2>/dev/null && pwd -P)/$(basename -- "$path")" "$suffix"
  else
    printf '%s%s' "$path" "$suffix"
  fi
}

# Run a query against a warm instance over Neovim's own RPC.
run_remote() {
  local socket=$1 command=$2
  shift 2
  command -v "$NVIM" >/dev/null 2>&1 || die "$NVIM is not on PATH"
  # The socket is checked after the dry run below: a dry run should not need a
  # live instance to tell you what it would send.

  # Arguments as JSON, so nothing has to be escaped three times over.
  #
  # Paths are made absolute *here*, in the caller's directory. The warm
  # instance resolves a relative path against its own working directory -- it
  # was started once, from some other shell -- so `cd project && kebab --server
  # … diagnostics src/Foo.java` reported "no such file", or worse, silently
  # answered about a different project's src/Foo.java. The one-shot path has no
  # such problem because the shell spawns Neovim in the caller's cwd.
  local args_json="[" first=1
  for a in "$@"; do
    [ $first -eq 1 ] || args_json="$args_json,"
    first=0
    args_json="$args_json$(json_str "$(absolute_query_arg "$a")")"
  done
  args_json="$args_json]"

  if [ -n "${KEBAB_DRY_RUN:-}" ]; then
    # The resolved arguments, not the ones typed: a path is made absolute in
    # the caller's directory, which is the whole point of this path.
    printf 'remote %s %s\n' "$command" "$args_json"
    return 0
  fi

  [ -S "$socket" ] || die "no instance listening at $socket (start one with: kebab serve)"

  local timeout_json=""
  [ -n "$QUERY_TIMEOUT" ] && timeout_json=",\"attach_timeout\":$QUERY_TIMEOUT"
  local request
  request=$(printf '{"command":"%s","args":%s,"opts":{"json":%s,"exit_code":%s%s}}' \
    "$command" "$args_json" "$QUERY_JSON" "$QUERY_EXIT_CODE" "$timeout_json")
  # One round trip. The reply is the exit code on the first line, then the
  # output -- three calls to read back a number and a string was silly.
  local reply
  reply=$("$NVIM" --server "$socket" --remote-expr \
    "luaeval(\"require('kebab.agent').remote(_A)\", $(vim_str "$request"))") || \
    die "could not reach the instance at $socket"

  local code=${reply%%$'\n'*}
  local out=${reply#*$'\n'}
  [ "$out" = "$reply" ] && out=""
  [ -n "$out" ] && printf '%s\n' "$out"
  case "$code" in
    ''|*[!0-9]*) return 1 ;;
    *) return "$code" ;;
  esac
}

server=""
if [ "${1-}" = "--server" ]; then
  [ $# -ge 2 ] || die "--server needs a socket path"
  server=$2
  shift 2
fi

cmd=${1-}
case "$cmd" in
  -h | --help | help)
    usage
    ;;

  -V | --version | version)
    printf 'kebab %s\n' "$VERSION"
    ;;

  list)
    run_headless "lua require('kebab.cli').print_and_quit(require('kebab.cli').list_lines())"
    ;;

  types)
    shift
    prompts=false
    [ "${1-}" = "--prompts" ] && prompts=true
    run_headless "lua require('kebab.cli').print_and_quit(require('kebab.cli').type_lines({ prompts = $prompts }))"
    ;;

  doctor)
    run_headless "lua local c = require('kebab.cli'); local l, ok = c.doctor_lines(); c.print_and_quit(l, ok)"
    ;;

  open)
    shift
    run_editor "lua require('kebab.cli').open($(lua_str "${1-}"))"
    ;;

  db)
    shift
    # A password is never stored by this layer -- a connection names an
    # environment variable -- so something has to put those variables in the
    # environment before Neovim starts. Neovim inherits this shell's, which is
    # why sourcing happens here and not in Lua.
    conn=""
    env_file="${KEBAB_DB_ENV:-}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --env)
          shift
          [ $# -gt 0 ] || die "--env needs a file"
          env_file=$1
          shift
          ;;
        --env=*)
          env_file=${1#--env=}
          shift
          ;;
        -*) die "unknown option for db: $1" ;;
        *)
          [ -z "$conn" ] || die "only one connection can be named: $conn and $1"
          conn=$1
          shift
          ;;
      esac
    done
    if [ -n "$env_file" ]; then
      # Expand ~ without the shell's glob or word splitting touching the rest.
      case "$env_file" in "~/"*) env_file="$HOME/${env_file#\~/}" ;; esac
      [ -f "$env_file" ] || die "no such env file: $env_file"
      [ -r "$env_file" ] || die "cannot read env file: $env_file"
      set -a
      # shellcheck disable=SC1090
      . "$env_file"
      set +a
    fi
    run_editor "lua require('kebab.cli').db($(lua_str "$conn"))"
    ;;

  new)
    shift
    # A leading value-less flag must not become the project name: `kebab new
    # --no-open --type empty` used to scaffold a project literally called
    # "--no-open" and then take the interactive branch anyway, because no_open
    # was never set.
    name=""
    case "${1-}" in
      -*) : ;;
      *)
        name=${1-}
        [ $# -gt 0 ] && shift || true
        ;;
    esac
    type=""
    dir=""
    no_open=""
    declare -A answers=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --type) [ $# -ge 2 ] || die "--type needs a value"; type=$2; shift 2 ;;
        --dir)  [ $# -ge 2 ] || die "--dir needs a value";  dir=$2;  shift 2 ;;
        --no-open) no_open=1; shift ;;
        --*)
          # Any other --name value answers a prompt the project type declares,
          # so a language that adds a question needs no change here. `kebab
          # types --prompts` lists what each type asks.
          key=${1#--}
          case "$key" in
            ""|*[!a-zA-Z0-9_-]*) die "not a valid option name: $1" ;;
          esac
          [ $# -ge 2 ] || die "$1 needs a value"
          answers[${key//-/_}]=$2
          shift 2
          ;;
        *) die "unknown argument for 'new': $1" ;;
      esac
    done

    spec="name = $(lua_str "$name")"
    [ -n "$type" ] && spec="$spec, type = $(lua_str "$type")"
    [ -n "$dir" ] && spec="$spec, dest = $(lua_str "$dir")"
    if [ ${#answers[@]} -gt 0 ]; then
      parts=""
      for k in "${!answers[@]}"; do
        [ -n "$parts" ] && parts="$parts, "
        # Bracket form, because a bare key has to be a Lua identifier: `local`
        # (a keyword) or `2fa` (a leading digit) would make the chunk a syntax
        # error, and a chunk that does not compile never reaches qa! -- so the
        # command hangs with no output instead of reporting anything.
        parts="$parts[$(lua_str "$k")] = $(lua_str "${answers[$k]}")"
      done
      spec="$spec, answers = { $parts }"
    fi
    if [ -n "$no_open" ]; then
      run_headless "lua require('kebab.cli').create_and_quit({ $spec })"
    else
      run_editor "lua require('kebab.cli').new({ $spec })"
    fi
    ;;

  diagnostics | definition | references | symbols | hover)
    shift
    parse_query_flags "$@"
    [ ${#QUERY_ARGS[@]} -gt 0 ] || die "$cmd needs a file"
    if [ -n "$server" ]; then
      run_remote "$server" "$cmd" "${QUERY_ARGS[@]}"
      exit $?
    fi
    # One-shot: boot, let a language server attach, answer, quit. Fine for
    # gopls and friends (~200ms); for jdtls use `kebab serve`, which indexes once.
    args_lua=""
    for a in "${QUERY_ARGS[@]}"; do
      [ -n "$args_lua" ] && args_lua="$args_lua, "
      args_lua="$args_lua$(lua_str "$a")"
    done
    query_lua="lua require('kebab.agent').main($(lua_str "$cmd"), { $args_lua }, $(query_opts_lua))"
    if [ -n "${KEBAB_DRY_RUN:-}" ]; then
      printf '%s\n' "$query_lua"
      exit 0
    fi
    # stderr is NOT folded into stdout here: a warning on the way out (an LSP
    # client quitting, a startup notice) would prefix the --json payload and
    # make it unparseable, which is worst exactly when the query degraded.
    "$NVIM" --headless -n -c "$query_lua"
    exit $?
    ;;

  serve)
    shift
    socket=$(default_socket)
    while [ $# -gt 0 ]; do
      case "$1" in
        --socket) [ $# -ge 2 ] || die "--socket needs a value"; socket=$2; shift 2 ;;
        *) die "unknown option for 'serve': $1" ;;
      esac
    done
    if [ ${#socket} -gt 100 ]; then
      die "socket path is too long for a unix socket (${#socket} chars): $socket"
    fi
    [ -S "$socket" ] && die "something is already listening at $socket"
    # Only a stale socket is removed. The guard above rejects a *live* socket,
    # but anything else at that path -- a regular file, someone's notes -- was
    # deleted outright.
    if [ -e "$socket" ] && [ ! -S "$socket" ]; then
      die "$socket exists and is not a socket; refusing to remove it"
    fi
    rm -f "$socket"
    printf 'kebab: listening on %s — query it with: kebab --server %s diagnostics <file>\n' \
      "$socket" "$socket" >&2
    exec "$NVIM" --headless -n --listen "$socket" \
      -c "lua vim.wait(120000, function() return _G.LazyVim ~= nil end, 50)"
    ;;

  "")
    # No arguments: open the IDE where we stand, with the project tree showing,
    # the way a graphical IDE opens a folder.
    run_editor "lua require('kebab.project').open_dir(vim.fn.getcwd())"
    ;;

  -*)
    die "unknown option: $cmd (try 'kebab help')"
    ;;

  *)
    # Anything else is treated as a path or a project name.
    run_editor "lua require('kebab.cli').open($(lua_str "$cmd"))"
    ;;
esac
